{
  "name": "pi-linux-computer",
  "version": "0.2.0",
  "description": "Structured Linux VM desktop control tools for Pi",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package",
    "computer-use",
    "accessibility",
    "linux"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {

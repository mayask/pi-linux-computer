{
  "name": "pi-linux-computer",
  "version": "0.2.0",
  "description": "Structured Linux VM desktop control tools for Pi",
  "type": "module",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/mayask/pi-linux-computer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayask/pi-linux-computer.git"
  },
  "bugs": {
    "url": "https://github.com/mayask/pi-linux-computer/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "pi-package",
    "computer-use",
    "accessibility",
    "linux"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:remote": "./scripts/integration-test.sh"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest"
  }
}

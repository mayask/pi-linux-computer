{
  "defaultTarget": "linux-vm",
  "targets": {
    "linux-vm": {
      "host": "127.0.0.1",
      "port": 2222,
      "user": "vmagent",
      "identityFile": "~/.ssh/linux-vm-agent_ed25519",
      "knownHostsFile": "~/.ssh/linux-vm-known_hosts",
      "display": ":10",
      "xauthority": "/home/vmagent/.Xauthority",
      "dbusAddress": "unix:path=/run/user/1001/bus"
    }
  }
}
